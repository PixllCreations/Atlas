# Atlas API
ATLAS_PORT=8080
ATLAS_DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas?sslmode=disable

# GitHub webhooks — one secret for Atlas; reuse on every repo webhook (POST /webhooks/github)
# Generate for production: openssl rand -hex 32
ATLAS_WEBHOOK_SECRET=dev-webhook-secret

# Docker registry — leave empty to skip push; set when running a local registry
ATLAS_REGISTRY_URL=localhost:5000
# Kaniko Job builds — dockerconfigjson Secret in ATLAS_K8S_NAMESPACE for registry push auth; leave empty if registry needs no auth
ATLAS_REGISTRY_SECRET=
# Kaniko Job builds — set true for insecure local registries (e.g. localhost:5000)
ATLAS_INSECURE_REGISTRY=true

# Kubernetes — leave kubeconfig empty for in-cluster or default ~/.kube/config; deploys skipped if unreachable
ATLAS_KUBECONFIG=
ATLAS_K8S_NAMESPACE=default

# Ingress — apps exposed at <app>.<domain>; leave empty to skip ingress
ATLAS_INGRESS_DOMAIN=homelab.local
ATLAS_INGRESS_CLASS=traefik
# TLS — name of a kubernetes.io/tls Secret in ATLAS_K8S_NAMESPACE; leave empty for HTTP only
ATLAS_INGRESS_TLS_SECRET=

# Docker Compose (Postgres)
ATLAS_DB_PASSWORD=atlas
ATLAS_DB_PORT=5432

# Tests (optional override for integration tests)
ATLAS_TEST_DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas?sslmode=disable
