# Atlas API
ATLAS_PORT=8080
ATLAS_DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas?sslmode=disable

# GitHub webhooks — one secret for Atlas; reuse on every repo webhook (POST /webhooks/github)
# Generate for production: openssl rand -hex 32
ATLAS_WEBHOOK_SECRET=dev-webhook-secret

# Docker Compose (Postgres)
ATLAS_DB_PASSWORD=atlas
ATLAS_DB_PORT=5432

# Tests (optional override for integration tests)
ATLAS_TEST_DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas?sslmode=disable
