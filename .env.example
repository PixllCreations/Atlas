# Copy to .env and fill in CLOUDFLARE_TUNNEL_TOKEN + ATLAS_WEBHOOK_SECRET

ATLAS_PORT=8080
ATLAS_DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas?sslmode=disable

# GitHub webhooks — openssl rand -hex 32
ATLAS_WEBHOOK_SECRET=dev-webhook-secret
ATLAS_WEBHOOK_PUBLIC_URL=https://hooks.edwardscott.dev/webhooks/github

# GitHub App (optional — enables Connect GitHub + automatic push webhooks)
# Register at https://github.com/settings/apps/new
# Callback URL: https://hooks.edwardscott.dev/auth/github/callback
# Setup URL (Post installation): same as callback — required for Connect GitHub redirect
# Webhook URL: https://hooks.edwardscott.dev/webhooks/github (same secret as above)
ATLAS_GITHUB_APP_ID=
ATLAS_GITHUB_APP_SLUG=
# Host path to the .pem (bind-mounted into the api container at /run/secrets/github-app.pem)
ATLAS_GITHUB_APP_PRIVATE_KEY_HOST=./edward-scott-atlas.private-key.pem
# ATLAS_GITHUB_APP_PRIVATE_KEY=   # PEM contents (alternative; skip mount/path)
ATLAS_GITHUB_CLIENT_ID=
ATLAS_GITHUB_CLIENT_SECRET=

ATLAS_REGISTRY_URL=atlas-registry:5000
ATLAS_INSECURE_REGISTRY=true
# System/build namespace for Kaniko Jobs only. App workloads use atlas-<project>.
ATLAS_K8S_NAMESPACE=default

# Public app URLs: https://<project>.edwardscott.dev
ATLAS_INGRESS_DOMAIN=edwardscott.dev
ATLAS_INGRESS_CLASS=traefik

# Required — Cloudflare Zero Trust → Tunnels → Docker token (see docs/cloudflare.md)
CLOUDFLARE_TUNNEL_TOKEN=

ATLAS_DB_PASSWORD=atlas
ATLAS_DB_PORT=5432

# Tests only — use a separate DB so go test does not pollute your atlas DB
ATLAS_TEST_DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas?sslmode=disable
